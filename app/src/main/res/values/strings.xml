    <string name="issue_knocking_name">Engine Knocking / Mechanical Impact</string>
    <string name="issue_knocking_desc">Heavy recurring rhythmic tapping detected inside the cylinder casing, suggesting pre-ignition, piston slap, or worn bearings.</string>
    <string name="issue_knocking_phrase">Check crankshaft main bearings, piston wrist pins, and dynamic compression ratio.</string>
    <string name="issue_knocking_rec">Stop driving immediately to prevent critical engine seizure. Tow vehicle to an authorized diagnostic center.</string>
    <string name="issue_belt_name">Dry/Squeaking Drive Belt Detected</string>
    <string name="issue_belt_desc">High-frequency friction slipping (3k-6k Hz) isolated at the front of the accessory drive pulleys.</string>
    <string name="issue_belt_phrase">Inspect serpentine belt tensioner pulley and check alternator shaft bearing wear.</string>
    <string name="issue_belt_rec">Schedule drive belt and tensioner pulley replacements within the next 200-300 miles to prevent failure.</string>
    <string name="issue_chain_name">Loose Timing Chain Rattle</string>
    <string name="issue_chain_desc">Metal-on-metal metallic fluttering isolated during idle transitions, indicating hydraulic tensioner wear.</string>
    <string name="issue_chain_phrase">Measure timing chain elongation and inspect timing guide wear guides.</string>
    <string name="issue_chain_rec">Schedule a tensioner replacement within 300 miles. Avoid rapid acceleration until serviced.</string>
    <string name="issue_bearing_name">Worn Pulley Bearing Hub</string>
    <string name="issue_bearing_desc">A low-pitched harmonic howling detected. Sound intensity rises linearly with engine RPM, indicating severe pulley bearing race pitting.</string>
    <string name="issue_bearing_phrase">Perform stethoscope checks on A/C compressor clutch and alternator pulley bearing.</string>
    <string name="issue_bearing_rec">Replace the pulley hub assembly soon. Continuing to run may cause the accessory drive to lock up entirely.</string>
    <string name="issue_tappet_name">Excessive Tappet / Valve Lash Noise</string>
    <string name="issue_tappet_desc">Rhythmic light ticking isolated in the upper cylinder head. Typical of excessive hydraulic lifter tolerance or low oil pressure.</string>
    <string name="issue_tappet_phrase">Check engine oil viscosity index, check oil pressure, and measure hot valve lash clearances.</string>
    <string name="issue_tappet_rec">Add suitable viscosity booster or perform an engine flush. Adjust valve tappets manually if lifters are solid.</string>
    <string name="issue_slip_name">Clutch Belt / CVT Slipping</string>
    <string name="issue_slip_desc">Friction frequency misalignment during rev cycles, indicating glaze on the dry pulley faces.</string>
    <string name="issue_slip_phrase">Examine CVT primary weight slider flats and clutch pad glaze condition.</string>
    <string name="issue_slip_rec">Clean CVT clutch bell dust and install replacement drive belt. Avoid hauling heavy cargo until replaced.</string>
    <string name="issue_healthy_name">Healthy &amp; Smooth Profile</string>
    <string name="issue_healthy_desc">Engine vibration frequency distribution matches expected factory acoustic baseline specs perfectly.</string>
    <string name="issue_healthy_phrase">Acoustic baseline check normal. Idle stability is exemplary.</string>
    <string name="issue_healthy_rec">No immediate repairs required. Continue with standard monthly wear-tracking reference checks.</string>
    <string name="issue_slippage_name">Slight Accessory Belt Slippage</string>
    <string name="issue_slippage_desc">Subtle high-frequency harmonic fluctuations indicating minor loss of serpentine belt elasticity.</string>
    <string name="issue_slippage_phrase">Measure serpentine tensioner spring displacement.</string>
    <string name="issue_slippage_rec">Schedule routine replacement at next standard service interval. Completely safe for normal driving.</string>
    <string name="issue_chatter_name">Minor CVT Clutch Chatter</string>
    <string name="issue_chatter_desc">Subtle rhythmic fluttering at idle speeds due to dry variator pulley face dust buildup.</string>
    <string name="issue_chatter_phrase">De-grease and blow-dry CVT faceplates.</string>
    <string name="issue_chatter_rec">Schedule routine replacement at next standard service interval. Completely safe for normal driving.</string>
    <string name="issue_alternator_name">Worn Alternator Pulley Bearing</string>
    <string name="issue_alternator_desc">Continuous growl (800-1200 Hz resonance) isolated at the front of the accessory belt loop.</string>
    <string name="issue_alternator_phrase">Check alternator free-wheel clutch and front hub bearing.</string>
    <string name="issue_alternator_rec">Address issue soon. Pulley lockup or chain jump could trigger complete engine failure.</string>
    <string name="issue_loosecam_name">Loose Cam Timing Chain</string>
    <string name="issue_loosecam_desc">Heavy metallic rustling inside cylinder head chamber. Indicates low tensioner oil pressure.</string>
    <string name="issue_loosecam_phrase">Check timing chain wear tolerances.</string>
    <string name="issue_loosecam_rec">Address issue soon. Pulley lockup or chain jump could trigger complete engine failure.</string>

